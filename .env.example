# Variables de entorno del backend. Copia los nombres y usa tus propios valores; nunca subas los reales.

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/fidegresa_db
DB_USERNAME=fidegresa
DB_PASSWORD=cambia-esta-clave

# Firma de los JWT (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-una-clave-larga-de-32-caracteres-o-mas
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_DAYS=14

# Dominios que pueden llamar a la API, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cuenta de demostración
SEED_DEMO=true
SEED_EMAIL=demo@ejemplo.com
SEED_PASSWORD=cambia-esta-clave

# Correo (opcional)
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Puerto HTTP
PORT=8080

# Los webhooks no usan variables: cada negocio tiene su secreto en la base de datos.

# Archivos que suben los dueños (catálogos PDF hasta 20 MB, imágenes hasta 5 MB).
# db = se guardan en PostgreSQL (por defecto). s3 = bucket compatible con S3 (AWS S3, Cloudflare R2, MinIO).
FILE_STORAGE=db
# Solo si FILE_STORAGE=s3. En R2: S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com y S3_REGION=auto.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Menú público del QR.
# Dirección del frontend, para armar el enlace completo del QR (ej. https://frontendfidegresa.vercel.app).
PUBLIC_WEB_URL=
# Versión del texto de consentimiento (Ley 29733) que acepta el cliente al unirse.
CONSENT_VERSION=2026-11
# Cabecera con la IP real del visitante detrás de un proxy (en Render: X-Forwarded-For). Vacío = IP de la conexión.
CLIENT_IP_HEADER=

# Google Wallet (pases de las tarjetas). Los mismos valores que ya usa Vercel para la tarjeta de prueba.
# ID de la entidad emisora (Google Pay & Wallet Console).
GOOGLE_WALLET_ISSUER_ID=
# Contenido completo del JSON de la cuenta de servicio, en una sola línea.
GOOGLE_WALLET_SERVICE_ACCOUNT=
# Logo del pase: URL HTTPS pública (ej. https://frontendfidegresa.vercel.app/icon-512.png).
GOOGLE_WALLET_LOGO_URL=

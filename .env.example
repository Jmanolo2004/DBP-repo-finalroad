# Variables de entorno del backend. Copia los nombres y usa tus propios valores; nunca subas los reales.

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/fidegresa_db
DB_USERNAME=fidegresa
DB_PASSWORD=cambia-esta-clave

# Firma de los JWT (mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-una-clave-larga-de-32-caracteres-o-mas
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_DAYS=14

# Dominios que pueden llamar a la API, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cuenta de demostración
SEED_DEMO=true
SEED_EMAIL=demo@ejemplo.com
SEED_PASSWORD=cambia-esta-clave

# Correo (opcional)
MAIL_HOST=smtp.ejemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Puerto HTTP
PORT=8080

# Los webhooks no usan variables: cada negocio tiene su secreto en la base de datos.
